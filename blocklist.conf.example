# unifi-blocklist configuration. Copied to blocklist.conf on install.
#
# Pick categories with `blocklist.sh menu` (TUI) or `blocklist.sh enable KEY`.
# They are stored in categories.enabled; the lists behind them are defined in
# categories.list. This file is only for extras and limits.

# Extra list URLs on top of the selected categories (plain, hosts or adblock format).
LIST_URLS=(
  # "https://big.oisd.nl/domainswild2"   # OISD Big
)

# All lists together must be within these bounds or they are not applied. MIN_ENTRIES
# only applies when downloaded lists are selected (not to custom domains on their own).
# UniFi limits CoreDNS to about 265 MB on a UCG Ultra, and 1.2M domains use about
# 200 MB of it. If CoreDNS reaches the limit, it is killed and restarted, and DNS
# pauses. `blocklist.sh status` shows the current use.
MIN_ENTRIES=1000
MAX_ENTRIES=1300000

# 1 = the Ad Block level chosen in the menu replaces UniFi's own Ad Block list, and
# UniFi stops downloading its list. 0 = UniFi keeps its own list and the chosen
# level goes into the block list next to it. Run `blocklist.sh update` after changing.
REPLACE_UNIFI_ADBLOCK=1

# Seconds between checks that UniFi hasn't regenerated the block file.
WATCH_INTERVAL=15

# Seconds to wait after a restart for CoreDNS to load the list and block again.
# Loading takes about 10 s per 900,000 domains; if it doesn't block in time, the
# previous list is put back.
RESTART_TIMEOUT=120

# 1 = check GitHub for a newer release during the scheduled update and show a
# notice in status and the menu. Nothing is installed automatically. 0 = off.
UPDATE_CHECK=1

# Extra domains to block, one per line (optional).
CUSTOM_BLOCK_FILE="/data/unifi-blocklist/custom-block.list"
